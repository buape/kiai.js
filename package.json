{
	"name": "kiai.js",
	"version": "4.0.1",
	"description": "The official JS/TS API library for Kiai",
	"keywords": [
		"api",
		"buape",
		"discord",
		"kiai",
		"leveling",
		"levels"
	],
	"bugs": {
		"url": "https://github.com/buape/kiai.js/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Shadow",
		"email": "shadow@buape.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/buape/kiai.js.git"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "bun run build.ts",
		"lint": "oxfmt --write . && oxlint",
		"prepare": "lefthook install",
		"publish": "bun run build && bun x changeset publish --no-git-tag",
		"publish:snapshot": "bun run build && changeset version --snapshot beta && changeset publish --tag beta --no-git-tag",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"typedoc": "typedoc"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@types/bun": "1.4.4",
		"bun-plugin-dts": "0.4.0",
		"lefthook": "2.2.2",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"typedoc": "0.28.20",
		"typedoc-plugin-frontmatter": "1.3.3",
		"typedoc-plugin-markdown": "4.14.1",
		"typedoc-plugin-mdn-links": "5.1.1"
	},
	"engines": {
		"node": ">=24.21.0"
	},
	"trustedDependencies": [
		"lefthook"
	]
}
